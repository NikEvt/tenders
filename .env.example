# Скопируйте в .env и заполните. .env в git не попадает (см. .gitignore).

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=zakupki
POSTGRES_USER=zakupki
POSTGRES_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=zakupki
RABBITMQ_PASSWORD=change-me
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=zakupki
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=tender-documents
MINIO_SECURE=false

# ─── ЕИС zakupki.gov.ru ───────────────────────────────────────────────────────
# Токен индивидуального пользователя ЕИС.
# ВНИМАНИЕ: прежний токен лежал в открытом виде в docker-compose.yml и test.py —
# считайте его скомпрометированным и перевыпустите в личном кабинете ЕИС.
EIS_TOKEN=
# Коды субъектов через запятую либо `all` — все 85.
# Вся Россия даёт примерно в 13 раз больше извещений, чем одна Москва.
EIS_REGIONS=all
EIS_DOCUMENT_TYPES=epNotificationEF2020
EIS_CRAWL_INTERVAL_MINUTES=60

# ─── LLM (OpenAI-совместимый эндпоинт) ────────────────────────────────────────
# Локальный сервер (vLLM, llama.cpp, Ollama). Из контейнера хост-машина доступна
# как host.docker.internal, а не localhost.
# LLM_BASE_URL=http://host.docker.internal:8080/v1
# LLM_MODEL=qwen3.6-35B-A3B
#
# Yandex Cloud: модель задаётся полным URI gpt://<folder-id>/<модель>/<версия>.
# Folder ID виден в тексте ошибки, если указать неверный: сервис отвечает
# «does not match with service account folder ID '<ваш-id>'».
LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_MODEL=gpt://<folder-id>/qwen3.6-35b-a3b/latest
LLM_API_KEY=
# Bearer (по умолчанию в OpenAI SDK) или Api-Key — штатная схема Yandex Cloud.
LLM_AUTH_SCHEME=Api-Key
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=180

# Уровень рассуждений reasoning-моделей. Qwen3.6 на односложный ответ тратит
# ~700 токенов размышлений против 2 с выключенными — поэтому по умолчанию none,
# и только LLM-судье по документам даётся бюджет на рассуждение.
LLM_REASONING_EFFORT=none
LLM_JUDGE_REASONING_EFFORT=low

# ─── Эмбеддинги ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=deepvk/USER-bge-m3
EMBEDDING_DIM=1024
EMBEDDING_SERVICE_URL=http://embedding-service:8020

# ─── Внутренние адреса сервисов ───────────────────────────────────────────────
LLM_SERVICE_URL=http://llm-service:8010
RECSYS_SERVICE_URL=http://recsys-service:8030
API_URL=http://api:8000

# ─── Веб-интерфейс ────────────────────────────────────────────────────────────
# Адрес API так, как его видит браузер, а не контейнер: `http://api:8000`
# из браузера не резолвится. Значение вшивается в клиентский бандл на сборке —
# после изменения нужно пересобрать образ web.
WEB_API_URL=http://localhost:8000

# ─── Общее ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true

# Устройство инференса эмбеддингов: пусто — авто (cuda → mps → cpu).
# MPS доступен только при нативном запуске на macOS: в Docker Desktop
# контейнер работает в Linux-VM, куда Metal не пробрасывается.
EMBEDDING_DEVICE=

# ─── Пропускная способность конвейера документов ──────────────────────────────
# Сколько извещений docs-worker разбирает одновременно (внутри извещения файлы
# идут по очереди). Разбор большого бэклога — тот случай, когда стоит поставить
# 1: система останется отзывчивой, просто разберётся дольше.
DOCS_WORKER_PREFETCH=2
# Сколько запросов на эмбеддинги считается разом.
EMBEDDING_PREFETCH=2
