# Настройки установки. start.bat создаёт из этого файла .env при первом запуске:
# пароли внутренних служб генерируются случайно прямо на вашей машине и никуда
# не передаются. Заполнить руками нужно только два поля — токен ЕИС и ключ LLM.
#
# Файл .env содержит ваши секреты. Не пересылайте его и не кладите в общие папки.

# ─── Версия поставки. Не меняйте: под этим тегом загружены образы ─────────────
ZAKUPKI_TAG=__TAG__

# ─── Токен ЕИС zakupki.gov.ru (обязателен) ────────────────────────────────────
# Токен индивидуального пользователя из личного кабинета ЕИС.
# Личный кабинет → Администрирование → Пользователи → ваш пользователь →
# Настройки интеграции → сгенерировать токен.
EIS_TOKEN=

# Коды субъектов через запятую либо `all` — все 85. Начните с одного региона:
# вся Россия даёт примерно в 13 раз больше извещений, чем одна Москва.
EIS_REGIONS=77
EIS_DOCUMENT_TYPES=epNotificationEF2020
EIS_CRAWL_INTERVAL_MINUTES=60

# ─── Языковая модель, OpenAI-совместимый эндпоинт (обязательна) ───────────────
# Вариант 1 — Yandex Cloud. Модель задаётся полным URI, folder-id ваш:
#   LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
#   LLM_MODEL=gpt://<folder-id>/qwen3.6-35b-a3b/latest
#   LLM_AUTH_SCHEME=Api-Key
#
# Вариант 2 — своя модель на этой же машине (vLLM, llama.cpp, Ollama).
# Из контейнера хост доступен как host.docker.internal, а не localhost:
#   LLM_BASE_URL=http://host.docker.internal:8080/v1
#   LLM_MODEL=qwen3.6-35B-A3B
#   LLM_AUTH_SCHEME=Bearer
#   LLM_API_KEY=dummy
LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_MODEL=gpt://<folder-id>/qwen3.6-35b-a3b/latest
LLM_API_KEY=
LLM_AUTH_SCHEME=Api-Key
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=180

# Рассуждения модели: на односложный ответ они тратят сотни лишних токенов,
# поэтому включены только у судьи по документам, где влияют на вердикт.
LLM_REASONING_EFFORT=none
LLM_JUDGE_REASONING_EFFORT=low

# ─── Уровень нагрузки: 1 фоновый · 2 средний · 3 полный ───────────────────────
# Задаёт лишь стартовое значение. Дальше уровень меняется на ходу из интерфейса
# и хранится в базе — перезапуск не нужен.
LOAD_LEVEL=2

# Сколько извещений docs-worker разбирает одновременно. Пусто — считается от
# уровня нагрузки. Ставьте 1, если во время разбора машина плохо отзывается.
DOCS_WORKER_PREFETCH=

# ─── Пароли внутренних служб ──────────────────────────────────────────────────
# Заполняются автоматически при первом запуске start.bat. Службы слушают только
# 127.0.0.1, из сети снаружи они недоступны.
POSTGRES_DB=zakupki
POSTGRES_USER=zakupki
POSTGRES_PASSWORD=
RABBITMQ_USER=zakupki
RABBITMQ_PASSWORD=
MINIO_ROOT_USER=zakupki
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=tender-documents

# ─── Журналы ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
