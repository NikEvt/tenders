# Скопируйте в .env.local для локальной разработки.
#
# Переменная попадает в клиентский бандл на этапе сборки: в docker-compose она
# передаётся build-аргументом, менять её после сборки образа бесполезно.
#
# Из браузера обращение идёт к опубликованному порту хоста, а не к имени
# контейнера: `http://api:8000` браузеру недоступен.
NEXT_PUBLIC_API_URL=http://localhost:8000
